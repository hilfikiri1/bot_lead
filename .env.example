APP_ENV=production
LOG_LEVEL=INFO
DATABASE_URL=
REDISHOST=
REDISPORT=6379
REDISUSER=
REDISPASSWORD=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_BASE_URL=
ALLOWED_TELEGRAM_USER_IDS=
# Alias also accepted:
TELEGRAM_ALLOWED_USER_IDS=
# Recommended after Agent v4 identity migration. If empty, the first allowlisted
# Telegram ID becomes Owner during bootstrap.
TELEGRAM_OWNER_USER_ID=
TELEGRAM_BOT_USERNAME=
MAX_AUDIO_FILE_SIZE_MB=20
AUDIO_PROCESSING_MODE=direct
AUDIO_QUEUE_FALLBACK_SECONDS=45

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# WhatsApp Cloud API stays disabled. Agent v4 manual Click to Chat does not
# require Meta credentials.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

KOMMO_BASE_URL=
KOMMO_ACCESS_TOKEN=
KOMMO_DEFAULT_PIPELINE_ID=
KOMMO_DEFAULT_STATUS_ID=
KOMMO_MENU_PIPELINE_ID=
KOMMO_DEFAULT_TASK_TYPE_ID=1
# Optional Kommo custom field ID for B&BS internal lead number (e.g. 120, 107).
KOMMO_INTERNAL_LEAD_NUMBER_FIELD_ID=
KOMMO_MENU_PAGE_SIZE=8
KOMMO_OPEN_LEADS_MAX_PAGES=20

CALENDAR_PROVIDER=google
GOOGLE_CALENDAR_AUTH_MODE=service_account
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_NAME=BBS Работа
GOOGLE_CALENDAR_TIMEZONE=Europe/Warsaw
GOOGLE_CALENDAR_DEFAULT_DURATION_MINUTES=30
GOOGLE_CALENDAR_DEFAULT_REMINDER_MINUTES=30
GOOGLE_CALENDAR_SEND_UPDATES=none
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Legacy iCloud CalDAV (optional)
ICLOUD_USERNAME=
ICLOUD_APP_SPECIFIC_PASSWORD=
ICLOUD_CALENDAR_NAME=BBS Работа
ICLOUD_CALDAV_URL=
ICLOUD_CALENDAR_URL=
MANAGER_TIMEZONE=Europe/Warsaw

NOTION_API_TOKEN=
# Internal Integration Secret из https://www.notion.so/my-integrations
# (Buy Bring Bot → Configuration → Secret). Формат: secret_... или ntn_...
NOTION_AUTO_SYNC=true
NOTION_CLIENTS_DATABASE_ID=
NOTION_LEADS_DATABASE_ID=
NOTION_CALLS_DATABASE_ID=
NOTION_TASKS_DATABASE_ID=
# Можно вставить полную ссылку Notion — для базы внутри страницы возьмётся ID из ?v=
# Private workspace OK. Для каждой базы: ⋯ → Connections → Buy Bring Bot.
# Напоминания в календарь работают без Notion tasks.
VOICE_COMMAND_MODE=true
MORNING_DIGEST_ENABLED=true
MORNING_DIGEST_HOUR=8

# Google Sheets lead registry (read-only service account)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME=
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_PHONE_COLUMN=O
GOOGLE_SHEETS_PRODUCT_COLUMN=P
GOOGLE_SHEETS_LEAD_NUMBER_COLUMN=Y
GOOGLE_SHEETS_EMAIL_COLUMN=
GOOGLE_SHEETS_CLIENT_NAME_COLUMN=
GOOGLE_SHEETS_COMPANY_COLUMN=
GOOGLE_SHEETS_STATUS_COLUMN=W
GOOGLE_SHEETS_HEADER_ROW=1
GOOGLE_SHEETS_CACHE_TTL_SECONDS=300
# Must remain false until the owner explicitly approves write access.
GOOGLE_SHEETS_WRITE_ENABLED=false

# Kommo -> Google Sheets status reconciliation.
# The scheduler only sends reports; it never writes automatically.
LEAD_STATUS_SYNC_ENABLED=false
LEAD_STATUS_SYNC_PIPELINE_ID=
LEAD_STATUS_SYNC_INTERVAL_MINUTES=180
LEAD_STATUS_SYNC_INITIAL_DELAY_SECONDS=90
LEAD_STATUS_SYNC_NOTIFY_ONLY_ON_DIFFERENCES=true

# Unreviewed Kommo leads (Kommo inbox «Неразобранное» / Facebook forms)
# Set pipeline ID from Kommo funnel settings when you have multiple funnels.
KOMMO_UNREVIEWED_PIPELINE_ID=
KOMMO_UNREVIEWED_STATUS_ID=
KOMMO_UNREVIEWED_STATUS_NAME=Incoming leads
KOMMO_UNREVIEWED_USE_UNSORTED=true
KOMMO_UNREVIEWED_HIDE_NUMBERED=false
KOMMO_UNREVIEWED_PAGE_SIZE=8

ADMIN_API_KEY=
CORS_ALLOWED_ORIGINS=
EXPOSE_API_DOCS=false
ENABLE_GOOGLE_OAUTH_ROUTES=false
SECRET_KEY=

# ============================================================
# Unified B&BS AI Agent v3
# ============================================================
AGENT_ENABLED=true
AGENT_AUTO_VOICE_MODE=true
# Leave empty to reuse OPENAI_MODEL
AGENT_PLANNER_MODEL=
AGENT_WRITER_MODEL=
AGENT_ACTION_TTL_MINUTES=30
AGENT_DIGEST_MAX_ITEMS=10
AGENT_SYNC_MAX_LEADS=50
AGENT_MEMORY_COMPACT_EVERY=20
AGENT_MEMORY_RECENT_MESSAGES=12
AGENT_DEFAULT_CLIENT_LANGUAGE=pl
AGENT_INVITE_TTL_HOURS=48

# Operational Notion Data Sources (new Russian B&BS workspace)
NOTION_PROJECTS_DATA_SOURCE_ID=fcb024d7-ac9f-4948-a2e9-715fa011c712
NOTION_TASKS_DATA_SOURCE_ID=56d63b07-c16c-4077-a78f-0b44741d58f0
NOTION_OFFERS_DATA_SOURCE_ID=e463541b-a37f-4d9e-a669-34b00f29543d
NOTION_CATALOGS_DATA_SOURCE_ID=c48bfbd8-3252-4d87-8bc0-e71486d5f012
NOTION_COMMUNICATIONS_DATA_SOURCE_ID=f99276f0-f95d-4aeb-8a5b-71fda8195492

# ============================================================
# B&BS AI Agent v4 — Operations + Google Drive
# ============================================================
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_INBOX_FOLDER_ID=
GOOGLE_DRIVE_PROJECTS_FOLDER_ID=
GOOGLE_DRIVE_PROJECT_TEMPLATE_FOLDER_ID=
AGENT_MORNING_DIGEST_ENABLED=false
AGENT_MORNING_DIGEST_HOUR=8
AGENT_EVENING_DIGEST_ENABLED=false
AGENT_EVENING_DIGEST_HOUR=19
AGENT_DIGEST_TIMEZONE=Europe/Warsaw
AGENT_DAILY_AI_BUDGET_USD=0
AGENT_MONTHLY_AI_BUDGET_USD=0
AGENT_COST_WARNING_PERCENT=80
