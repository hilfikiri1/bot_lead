# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/catalog_bot

# ── Brand ─────────────────────────────────────────────────────────────────────
BRAND_NAME=Babrik Solutions
BRAND_PRIMARY_COLOR=#0B1F3A
BRAND_ACCENT_COLOR=#D8A34A
BRAND_TEXT_COLOR=#20242A
BRAND_LOGO_PATH=app/catalog/static/logo.png
BRAND_WEBSITE=
BRAND_EMAIL=
BRAND_PHONE=

# ── Playwright ────────────────────────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_SECONDS=45
PLAYWRIGHT_STORAGE_STATE=storage/browser/1688_storage_state.json

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_CONCURRENT_JOBS=2
MAX_IMAGES=12
MAX_GALLERY_IMAGES=8
MAX_DETAIL_IMAGES=4
MAX_IMAGE_SIZE_MB=10
MAX_TOTAL_DOWNLOAD_MB=100
MIN_IMAGE_SIDE=300

# ── Storage ───────────────────────────────────────────────────────────────────
PDF_RETENTION_HOURS=24
TEMP_STORAGE_DIR=storage/temporary
OUTPUT_STORAGE_DIR=storage/output

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DEBUG_SAVE_PAGE=false
