APP_ENV=production
LOG_LEVEL=INFO
DATABASE_URL=
REDISHOST=
REDISPORT=6379
REDISUSER=
REDISPASSWORD=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_BASE_URL=
ALLOWED_TELEGRAM_USER_IDS=
MAX_AUDIO_FILE_SIZE_MB=20
AUDIO_PROCESSING_MODE=direct
AUDIO_QUEUE_FALLBACK_SECONDS=45

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

KOMMO_BASE_URL=
KOMMO_ACCESS_TOKEN=
KOMMO_DEFAULT_PIPELINE_ID=
KOMMO_DEFAULT_STATUS_ID=
KOMMO_MENU_PIPELINE_ID=
KOMMO_DEFAULT_TASK_TYPE_ID=1
KOMMO_MENU_PAGE_SIZE=8
KOMMO_OPEN_LEADS_MAX_PAGES=20

CALENDAR_PROVIDER=google
GOOGLE_CALENDAR_AUTH_MODE=service_account
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_NAME=BBS Работа
GOOGLE_CALENDAR_TIMEZONE=Europe/Warsaw
GOOGLE_CALENDAR_DEFAULT_DURATION_MINUTES=30
GOOGLE_CALENDAR_DEFAULT_REMINDER_MINUTES=30
GOOGLE_CALENDAR_SEND_UPDATES=none
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Legacy iCloud CalDAV (optional)
ICLOUD_USERNAME=
ICLOUD_APP_SPECIFIC_PASSWORD=
ICLOUD_CALENDAR_NAME=BBS Работа
ICLOUD_CALDAV_URL=
ICLOUD_CALENDAR_URL=
MANAGER_TIMEZONE=Europe/Warsaw

NOTION_API_TOKEN=
# Internal Integration Secret из https://www.notion.so/my-integrations
# (Buy Bring Bot → Configuration → Secret). Формат: secret_... или ntn_...
NOTION_AUTO_SYNC=true
NOTION_CLIENTS_DATABASE_ID=
NOTION_LEADS_DATABASE_ID=
NOTION_CALLS_DATABASE_ID=
NOTION_TASKS_DATABASE_ID=
# Можно вставить полную ссылку Notion — для базы внутри страницы возьмётся ID из ?v=
# Private workspace OK. Для каждой базы: ⋯ → Connections → Buy Bring Bot.
# Напоминания в календарь работают без Notion tasks.
VOICE_COMMAND_MODE=true
MORNING_DIGEST_ENABLED=true
MORNING_DIGEST_HOUR=8

# Google Sheets lead registry (read-only service account)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME=
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_PHONE_COLUMN=O
GOOGLE_SHEETS_PRODUCT_COLUMN=P
GOOGLE_SHEETS_LEAD_NUMBER_COLUMN=Y
GOOGLE_SHEETS_EMAIL_COLUMN=
GOOGLE_SHEETS_CLIENT_NAME_COLUMN=
GOOGLE_SHEETS_COMPANY_COLUMN=
GOOGLE_SHEETS_HEADER_ROW=1
GOOGLE_SHEETS_CACHE_TTL_SECONDS=300

# Unreviewed Kommo leads (Kommo inbox «Неразобранное» / Facebook forms)
# Set pipeline ID from Kommo funnel settings when you have multiple funnels.
KOMMO_UNREVIEWED_PIPELINE_ID=
KOMMO_UNREVIEWED_STATUS_ID=
KOMMO_UNREVIEWED_STATUS_NAME=Incoming leads
KOMMO_UNREVIEWED_USE_UNSORTED=true
KOMMO_UNREVIEWED_HIDE_NUMBERED=false
KOMMO_UNREVIEWED_PAGE_SIZE=8

ADMIN_API_KEY=
CORS_ALLOWED_ORIGINS=
EXPOSE_API_DOCS=false
ENABLE_GOOGLE_OAUTH_ROUTES=false
SECRET_KEY=

# 1688 catalog PDF generation
CATALOG_ENABLED=true
CATALOG_PROCESSING_MODE=celery
CATALOG_OPENAI_MODEL=
BRAND_NAME=Babrik Solutions
BRAND_PRIMARY_COLOR=#0B1F3A
BRAND_ACCENT_COLOR=#D8A34A
BRAND_TEXT_COLOR=#20242A
BRAND_LOGO_PATH=app/catalog/static/logo.png
BRAND_WEBSITE=
BRAND_EMAIL=
BRAND_PHONE=
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_SECONDS=45
PLAYWRIGHT_STORAGE_STATE=storage/browser/1688_storage_state.json
CATALOG_MAX_CONCURRENT_JOBS=2
CATALOG_MAX_IMAGES=12
CATALOG_MAX_IMAGE_SIZE_MB=10
CATALOG_MAX_TOTAL_DOWNLOAD_MB=100
CATALOG_PDF_RETENTION_HOURS=24
CATALOG_DEBUG_SAVE_PAGE=false
CATALOG_RATE_LIMIT_SECONDS=10
