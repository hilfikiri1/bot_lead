# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# Comma separated list of Telegram user IDs allowed to receive admin notifications (optional)
ADMIN_TELEGRAM_IDS=

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/catalog_bot

# ---- Branding ----
BRAND_NAME=Babrik Solutions
BRAND_PRIMARY_COLOR=#0B1F3A
BRAND_ACCENT_COLOR=#D8A34A
BRAND_TEXT_COLOR=#20242A
BRAND_LOGO_PATH=app/catalog/static/logo.png
BRAND_WEBSITE=
BRAND_EMAIL=
BRAND_PHONE=

# ---- Playwright ----
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_SECONDS=45
PLAYWRIGHT_STORAGE_STATE=storage/browser/1688_storage_state.json
PLAYWRIGHT_MAX_SCROLLS=12

# ---- Limits ----
MAX_CONCURRENT_JOBS=2
MAX_IMAGES=12
MAX_GALLERY_IMAGES=8
MAX_DETAIL_IMAGES=4
MAX_IMAGE_SIZE_MB=10
MAX_TOTAL_DOWNLOAD_MB=100
MIN_IMAGE_SIDE_PX=300
PDF_RETENTION_HOURS=24
RATE_LIMIT_SECONDS=15

# ---- Runtime ----
LOG_LEVEL=INFO
DEBUG_SAVE_PAGE=false
STORAGE_DIR=storage
RUN_MODE=polling
HEALTH_API_HOST=0.0.0.0
HEALTH_API_PORT=8000
