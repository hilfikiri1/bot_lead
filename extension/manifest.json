{
  "manifest_version": 3,
  "name": "Babrik 1688 Catalog",
  "version": "1.0.0",
  "description": "Собирает товары с 1688.com и формирует PDF-каталог Babrik Solutions",
  "permissions": ["activeTab", "storage", "scripting", "downloads"],
  "host_permissions": [
    "https://*.1688.com/*",
    "https://detail.1688.com/*",
    "http://localhost:8000/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Babrik 1688 Catalog",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.1688.com/*"],
      "js": ["src/content/selectors.js", "src/content/parser.js", "src/content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
